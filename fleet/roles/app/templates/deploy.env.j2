# Managed by Ansible (app role) — local edits will be overwritten.
#
# What fleet/deploy.sh and fleet/deploy-branch.sh need to deploy {{ app.key }}.
# Not secret: read by systemd for browser-mcp-deploy@{{ app.key }}.service,
# and sourced by deploy-branch.sh as {{ app_deploy_user }}.
UV={{ fleet_uv }}
UV_CACHE_DIR={{ app_uv_cache_dir }}
UV_PYTHON_INSTALL_DIR={{ app_python_dir }}
UV_PYTHON_DOWNLOADS=automatic
APP_DISTRIBUTION={{ app_distribution }}
APP_SYSTEMD_UNIT={{ app_unit }}
PLAYWRIGHT_BROWSERS_PATH={{ fleet_browsers_dir }}

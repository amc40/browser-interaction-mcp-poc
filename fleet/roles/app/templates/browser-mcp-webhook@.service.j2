# Managed by Ansible (app role) — local edits will be overwritten.
#
# One instance per app: browser-mcp-webhook@<app>.service, running as that
# app's deploy account with that app's own secret, able to trigger that app's
# deploy and nothing else (docs/scaling-plan.md D5).
[Unit]
Description=browser MCP app %i deploy webhook — verifies a signed push and triggers a code-only redeploy
Documentation=https://github.com/amc40/browser-interaction-mcp-poc
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User={{ fleet_deploy_user_prefix }}%i
Group={{ fleet_deploy_user_prefix }}%i
WorkingDirectory={{ fleet_opt_root }}/%i/checkout
EnvironmentFile={{ fleet_config_root }}/%i/webhook.env
# Run directly with the system interpreter, not the venv - see the module
# docstring for why it must survive a uv sync that a bad commit broke.
ExecStart=/usr/bin/python3 {{ fleet_opt_root }}/%i/checkout/packages/core/src/browser_mcp_core/deploy_webhook.py
Restart=on-failure
RestartSec=5

# --- Sandboxing ------------------------------------------------------------
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077

# Deliberately absent, both because this unit shells out to sudo (see
# sudoers.j2) to trigger the oneshot deploy unit:
#   NoNewPrivileges  — blocks exactly the setuid escalation sudo relies on.
#   SystemCallFilter — @system-service is not guaranteed to cover whatever
#                      syscalls sudo's own privilege transition needs, and
#                      getting that subtly wrong would only surface as a
#                      silent failure the one time the webhook actually fires.

[Install]
WantedBy=multi-user.target

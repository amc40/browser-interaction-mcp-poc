# Managed by Ansible (app role) — local edits will be overwritten.
#
# {{ app.key }}'s settings. Read by systemd as EnvironmentFile, as root, before
# dropping to {{ app_service_user }} - not by python-dotenv. Only the keys the
# app's settings class declares may appear here: extra="forbid" means one
# unrecognised BROWSER_MCP_* key is a startup failure.

# MCP carries credentials in HTTP headers, and stdio has none — so http is the
# only transport that can authenticate anyone.
BROWSER_MCP_TRANSPORT=http

# Loopback. cloudflared dials localhost, so nothing routable is ever bound.
BROWSER_MCP_HOST={{ mcp_bind_host }}
BROWSER_MCP_PORT={{ app.value.port }}

BROWSER_MCP_LOG_LEVEL={{ mcp_log_level }}

# One process, so the in-memory token bucket is an honest rate limit. Never
# run an app on two hosts.
BROWSER_MCP_RATE_LIMIT_PER_SECOND={{ mcp_rate_limit_per_second }}
BROWSER_MCP_RATE_LIMIT_BURST={{ mcp_rate_limit_burst }}

# Never true on a reachable server: it sends internal errors and tracebacks,
# which will include browser state, to whoever is calling.
BROWSER_MCP_INCLUDE_ERROR_DETAILS=false

# The one account allowed to call tools, as GitHub's immutable numeric ID.
BROWSER_MCP_GITHUB_USER_ID={{ mcp_github_user_id }}
BROWSER_MCP_GITHUB_TOKEN_CACHE_SECONDS={{ mcp_github_token_cache_seconds }}

BROWSER_MCP_GITHUB_CLIENT_ID={{ mcp_github_client_id }}
BROWSER_MCP_GITHUB_CLIENT_SECRET={{ mcp_github_client_secret }}

# TLS terminates at Cloudflare's edge and the last hop is plain http, so FastMCP
# has to be told the public URL: it decides whether to mark its OAuth cookies
# `Secure` by testing whether this starts with https://, and builds its
# advertised OAuth metadata from it rather than from forwarded headers.
BROWSER_MCP_GITHUB_OAUTH_BASE_URL={{ app_oauth_base_url }}
{% if app_settings_merged %}

# The app's own settings: apps.yml's, with local.yml's personal ones over them.
{% for key, value in app_settings_merged | dictsort %}
BROWSER_MCP_{{ key }}={{ value | string | replace('{state_dir}', app_state_dir) }}
{% endfor %}
{% endif %}

# Not BROWSER_MCP_-prefixed, so pydantic-settings ignores them. These keep the
# browser profile, the caches and the OAuth store — which holds upstream GitHub
# tokens at rest — in the app's own state directory.
HOME={{ app_state_dir }}
XDG_CACHE_HOME={{ app_state_dir }}/cache
XDG_DATA_HOME={{ app_state_dir }}/data
PLAYWRIGHT_BROWSERS_PATH={{ fleet_browsers_dir }}

# Managed by Ansible (app role) — local edits will be overwritten.
#
# Read by systemd as EnvironmentFile, as root, before dropping to
# {{ app_deploy_user }}.
DEPLOY_WEBHOOK_SECRET={{ app_webhook_secret }}
DEPLOY_WEBHOOK_PORT={{ app.value.webhook_port }}

# The one thing sudoers.j2's NOPASSWD rule names, so the two can never drift
# out of sync the way a value hardcoded in deploy_webhook.py would.
DEPLOY_ONESHOT_UNIT={{ app_deploy_unit }}

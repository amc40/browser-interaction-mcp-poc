# Copy to .env and edit. Every setting is optional; the defaults below are the
# ones the server uses when the variable is unset. .env is gitignored.

# stdio | http
# Only http can authenticate callers; stdio trusts anyone with local shell
# access. See docs/sdr/0001-github-authentication.md.
BROWSER_MCP_TRANSPORT=stdio

# Only used by the http transport. Keep this on loopback: the server acts with
# your own credentials, so it must not be reachable from the network.
BROWSER_MCP_HOST=127.0.0.1
BROWSER_MCP_PORT=8000

BROWSER_MCP_LOG_LEVEL=INFO

# Sustained tool calls per second, and how many may be made back-to-back.
BROWSER_MCP_RATE_LIMIT_PER_SECOND=1.0
BROWSER_MCP_RATE_LIMIT_BURST=5

# Local debugging only: sends internal error details and tracebacks to clients.
BROWSER_MCP_INCLUDE_ERROR_DETAILS=false

# The one GitHub account allowed to use the server, as its numeric user ID
# rather than its login: logins can be changed, and a freed login can be
# registered by somebody else. Find yours at https://api.github.com/users/<login>.
BROWSER_MCP_GITHUB_USER_ID=36701168

# How long a verified GitHub token stays cached. Without a cache every request
# costs two GitHub API calls; with one, a token revoked on GitHub keeps working
# until its entry expires. Set 0 to disable caching and revoke immediately.
BROWSER_MCP_GITHUB_TOKEN_CACHE_SECONDS=300

# Credentials of the GitHub OAuth app clients authenticate against. Both are
# required by the http transport, which refuses to start without them. Register
# one at https://github.com/settings/developers with the callback URL below.
# BROWSER_MCP_GITHUB_CLIENT_ID=Ov23li...
# BROWSER_MCP_GITHUB_CLIENT_SECRET=

# Public base URL the OAuth callback is reachable at, which must match the
# OAuth app's own callback URL. Defaults to http://HOST:PORT, which is right
# when the client runs on this machine; set it when tunnelling or proxying.
# BROWSER_MCP_GITHUB_OAUTH_BASE_URL=http://127.0.0.1:8000

# Path to a captured Sainsbury's session (cookies + local storage, not a
# password), produced by running `scripts/sainsburys_login.py` locally and
# logging in by hand. Required by sainsburys_add_to_basket; unset, that tool
# refuses to run. Never commit the file this points at.
# BROWSER_MCP_SAINSBURYS_STORAGE_STATE_PATH=/path/to/sainsburys_storage_state.json

# Copy to .env and edit. Every setting is optional; the defaults below are the
# ones the server uses when the variable is unset. .env is gitignored.

# stdio | http
BROWSER_MCP_TRANSPORT=stdio

# Only used by the http transport. Keep this on loopback: the server acts with
# your own credentials, so it must not be reachable from the network.
BROWSER_MCP_HOST=127.0.0.1
BROWSER_MCP_PORT=8000

BROWSER_MCP_LOG_LEVEL=INFO

# Sustained tool calls per second, and how many may be made back-to-back.
BROWSER_MCP_RATE_LIMIT_PER_SECOND=1.0
BROWSER_MCP_RATE_LIMIT_BURST=5

# Local debugging only: sends internal error details and tracebacks to clients.
BROWSER_MCP_INCLUDE_ERROR_DETAILS=false

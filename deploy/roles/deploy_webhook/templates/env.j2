# Managed by Ansible (deploy_webhook role) — local edits will be overwritten.
#
# Read by systemd as EnvironmentFile, so it's parsed as root before dropping
# to User={{ deploy_user }} — same trick as roles/app/templates/env.j2.
DEPLOY_WEBHOOK_SECRET={{ mcp_deploy_webhook_secret }}
DEPLOY_WEBHOOK_PORT={{ deploy_webhook_port }}

# The one thing sudoers.j2's NOPASSWD rule actually names, so the two can
# never drift out of sync the way a value hardcoded in deploy_webhook.py
# would.
DEPLOY_ONESHOT_UNIT={{ deploy_oneshot_systemd_unit }}.service
